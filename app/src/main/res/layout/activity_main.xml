<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/input_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите фразу"
        android:minLines="2"
        android:layout_marginBottom="20dp"/>

    <Spinner
        android:id="@+id/lang_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/lang_array"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/speak_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Озвучить"/>

        <Button
            android:id="@+id/translate_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Перевести"
            android:layout_marginStart="16dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/voice_input_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎤 Голосовой ввод"/>


    <Button
        android:id="@+id/toggle_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵Включить музыку"/>



</LinearLayout>
